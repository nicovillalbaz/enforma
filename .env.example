NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://forma_api:forma_local_api@127.0.0.1:54329/forma
DATABASE_ADMIN_URL=postgres://forma_admin:forma_local_admin@127.0.0.1:54329/forma
API_DATABASE_PASSWORD=forma_local_api
WORKER_DATABASE_PASSWORD=forma_local_worker
WORKER_DATABASE_URL=postgres://forma_worker:forma_local_worker@127.0.0.1:54329/forma
POSTGRES_PASSWORD=forma_local_admin
COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
STORAGE_PATH=.local/storage
BACKUP_PASSPHRASE=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Forma <no-reply@localhost>

# Optional production subdomain base; keep empty for slug URLs in local.
TENANT_BASE_DOMAIN=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional absolute paths when FFmpeg/FFprobe are not available in PATH.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe

# Optional real monthly inputs for ops:check (PYG); blank means unknown.
COST_VPS_MONTHLY_PYG=
COST_BACKUP_MONTHLY_PYG=
COST_SUPPORT_100_MONTHLY_PYG=

# T08: optional controlled ClamAV INSTREAM endpoint; blank blocks uploaded PDFs.
# No antivirus or browser is downloaded or started automatically by setup.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional production Chromium executable; local uses installed Playwright Chromium.
PDF_CHROMIUM_PATH=

# T10: conversions in parallel (1 or 2); default 1 for low resource use.
MEDIA_WORKER_CONCURRENCY=1

# T14: empty = direct local API. Production overlay fixes Caddy's immediate IP.
# Never expose the API port publicly; adapt both subnet/IP if they conflict on the VPS.
TRUSTED_PROXY_IP=
EDGE_SUBNET=172.30.14.0/29
CADDY_PROXY_IP=172.30.14.2
