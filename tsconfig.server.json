{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/db/src/**/*.ts",
    "packages/shared/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts"
  ]
}
