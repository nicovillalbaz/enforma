{
  "name": "forma-coaching",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently -k -n api,web,media,documents,followup \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:media\" \"npm run dev:documents\" \"npm run dev:followup\"",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsx scripts/build-offline-shell.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "preview:api": "tsx scripts/preview-api.ts",
    "typecheck": "vue-tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts *.mjs",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:local": "tsx scripts/local-database.ts",
    "backup": "tsx scripts/backup.ts",
    "dev:media": "tsx apps/worker/src/media-server.ts",
    "media:maintenance": "tsx scripts/media-maintenance.ts",
    "ops:check": "tsx scripts/operations-check.ts",
    "dev:documents": "tsx apps/worker/src/documents-server.ts",
    "dev:followup": "tsx apps/worker/src/followup-server.ts",
    "release:check": "tsx scripts/release-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.0"
  }
}
